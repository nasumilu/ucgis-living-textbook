  "require-dev" : {
    "friendsofphp/php-cs-fixer" : "3.95.25",
    "phpstan/extension-installer" : "1.4.3",
    "phpstan/phpstan" : "2.2.14",
    "phpstan/phpstan-doctrine" : "2.0.28",
    "phpstan/phpstan-phpunit" : "2.0.18",
    "phpstan/phpstan-symfony" : "2.0.20",
    "phpunit/phpunit" : "13.3.4",
    "rector/rector" : "2.6.7",
    "symfony/error-handler" : "v7.4.17",
    "symfony/phpunit-bridge" : "v7.4.18",
    "symfony/stopwatch" : "v7.4.8",
    "symfony/web-profiler-bundle" : "v7.4.19",
    "vincentlanglet/twig-cs-fixer" : "4.1.1"
  },
  "config" : {
    "preferred-install" : {
      "*" : "dist"
    },
    "component-dir" : "public/elfinder-assets",
    "sort-packages" : true,
    "allow-plugins" : {
      "symfony/flex" : true,
      "symfony/runtime" : true,
      "php-http/discovery" : false,
      "phpstan/extension-installer" : true
    },
    "audit" : {
      "abandoned" : "report"
    }
  },
  "autoload" : {
    "psr-4" : {
      "App\\" : "src/"
    }
  },
  "autoload-dev" : {
    "psr-4" : {
      "App\\Tests\\" : "tests/"
    }
  },
  "replace" : {
    "symfony/polyfill-apcu" : "*",
    "symfony/polyfill-ctype" : "*",
    "symfony/polyfill-iconv" : "*",
    "symfony/polyfill-mbstring" : "*",
    "symfony/polyfill-php72" : "*",
    "symfony/polyfill-php73" : "*",
    "symfony/polyfill-php74" : "*",
    "symfony/polyfill-php80" : "*",
    "symfony/polyfill-php81" : "*",
    "symfony/polyfill-php82" : "*",
    "symfony/polyfill-php83" : "*",
    "symfony/polyfill-php84" : "*"
  },
  "scripts" : {
    "auto-scripts" : {
      "assets:install --symlink --relative %PUBLIC_DIR%" : "symfony-cmd",
      "fos:js-routing:dump --format=json --target=assets/js/_fos_routes.json" : "symfony-cmd"
    },
    "post-install-cmd" : [
      "@auto-scripts"
    ],
    "post-update-cmd" : [
      "@auto-scripts"
    ]
  },
  "conflict" : {
    "symfony/symfony" : "*"
  },
  "extra" : {
    "symfony" : {
      "allow-contrib" : false,
      "require" : "7.4.*"
    }
  }
}
