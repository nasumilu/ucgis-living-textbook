    "phpoffice/phpspreadsheet": "5.9.0",
    "rollerworks/password-strength-validator": "3.0.0",
    "stof/doctrine-extensions-bundle": "1.15.3",
    "sweetrdf/easyrdf": "1.19.0",
    "sweetrdf/json-ld": "1.4.3",
    "symfony/asset": "7.4.8",
    "symfony/cache": "7.4.19",
    "symfony/config": "7.4.17",
    "symfony/console": "7.4.19",
