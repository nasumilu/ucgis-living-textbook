    "symfony/service-contracts": "v3.7.3",
    "symfony/string": "v7.4.19",
    "symfony/translation": "v7.4.17",
    "symfony/translation-contracts": "3.7.1",
    "symfony/twig-bridge": "v7.4.19",
    "symfony/twig-bundle": "v7.4.19",
    "symfony/validator": "v7.4.19",
    "symfony/webpack-encore-bundle": "2.4.1",
    "symfony/yaml": "v7.4.18",
    "twig/cssinliner-extra": "3.26.0",
    "twig/extra-bundle": "3.29.0",
    "twig/inky-extra": "3.26.0",
    "twig/intl-extra": "3.29.0",
    "twig/string-extra": "^v3.24",
    "twig/twig": "3.29.0",
    "zircote/swagger-php": "6.1.2"
