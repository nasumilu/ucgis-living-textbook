    "symfony/finder": "v7.4.19",
    "symfony/flex": "2.11.0",
    "symfony/form": "v7.4.19",
    "symfony/framework-bundle": "7.4.19",
    "symfony/http-client": "v7.4.19",
    "symfony/http-client-contracts": "3.7.3",
    "symfony/http-foundation": "v7.4.19",
    "symfony/http-kernel": "v7.4.19",
    "symfony/lock": "v7.4.18",
    "symfony/mailer": "v7.4.19",
    "symfony/messenger": "v7.4.19",
    "symfony/mime": "v7.4.19",
    "symfony/monolog-bundle": "4.1.0",
    "symfony/options-resolver": "v7.4.8",
    "symfony/password-hasher": "v7.4.8",
    "symfony/process": "v7.4.19",
    "symfony/property-access": "v7.4.16",
    "symfony/rate-limiter": "v7.4.18",
